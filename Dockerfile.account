#
# Stage 1: Builder
#
FROM python:3.12-slim-trixie AS builder

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Copy uv binary from the source image INTO the builder stage
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./

ARG SCM_VERSION="0.0.0"
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${SCM_VERSION}

# Install dependencies into a virtual environment, but NOT the project itself
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package memmachine-account --no-install-workspace --no-editable --no-dev

# Copy the application source code
COPY . /app

# Install the project itself from the local source
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package memmachine-account --no-editable --no-dev

#
# Stage 2: Final
#
FROM python:3.12-slim-trixie AS final

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

WORKDIR /app

# Copy the environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Set the PATH to include the virtual environment's bin directory
ENV PATH="/app/.venv/bin:$PATH"

# server.host in the mounted config (default "0.0.0.0", see server/config.py)
# controls the bind address - no HOST env var is read here.
EXPOSE 8090
CMD ["sh", "-c", "memmachine-account-server"]
