# MemMachine Docker Compose Environment Configuration
# Copy this file to .env and update the values according to your setup

# =============================================================================
# PostgreSQL/pgvector Database Configuration
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=memmachine
POSTGRES_PASSWORD=memmachine_password
POSTGRES_DB=memmachine

# =============================================================================
# Neo4j Database Configuration
# =============================================================================
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_HTTPS_PORT=7473

# =============================================================================
# MemMachine Application Configuration
# =============================================================================
MEMORY_CONFIG=configuration.yml
MCP_BASE_URL=http://memmachine:8080
GATEWAY_URL=http://localhost:8080
FAST_MCP_LOG_LEVEL=INFO
MEMMACHINE_WORKERS=1
# Enable configuration management API endpoints 
# (uncomment and set to any non-empty value to enable, e.g., "true" or "1")
# MEMMACHINE_CONFIG_API=true

# =============================================================================
# OpenAI API Configuration (Required for embeddings and LLM)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Optional: Additional Configuration
# =============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# MemMachine server port (internal only - no longer published to the host,
# see packages/account/DESIGN.md §2/§11; kept here only in case you run
# MemMachine directly instead of through docker-compose)
MEMORY_SERVER_PORT=8080

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Account gateway (packages/account) - the publicly exposed entry point
# =============================================================================
# Port the account gateway is published on. Copy sample_configs/account.yml.sample
# to ./account.yml and fill in your SMTP/email-domain settings before starting.
MEMMACHINE_ACCOUNT_PORT=8090
